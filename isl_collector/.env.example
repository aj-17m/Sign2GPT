# Copy this file to .env (for local testing) or set these as
# environment variables in Render's dashboard.

# ---- S3 storage (where videos are stored) ----
S3_BUCKET=isl-videos
S3_REGION=us-east-1
S3_ACCESS_KEY=AKIA...your-access-key...
S3_SECRET_KEY=your-secret-key-here

# Only set this if you're using Cloudflare R2 (not AWS S3).
# For AWS S3, leave this commented out.
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ---- Admin auth ----
# Username is always "admin". This is the password.
# CHANGE THIS to something only you know.
ADMIN_PASSWORD=your-secret-admin-password-here

# ---- Upload limits ----
MAX_VIDEO_MB=50

# ---- Where to store the SQLite database locally ----
# On Render free tier, /tmp is the only writable path.
# The .db file gets auto-backed-up to S3 on every write.
LOCAL_DB_PATH=/tmp/isl_data.db
